# Dependencies (regenerated by composer install / npm install)
/vendor
node_modules/

# Environment & secrets — NEVER commit these
.env
.env.backup
.env.backup-before-mock

# Laravel runtime
/public/hot
/public/storage
/storage/*.key
.phpunit.result.cache

# Local / dev cruft
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
a.diff
diff.patch

# Accessibility test artifacts (screenshots are regenerated; the documented ones live in delivery-docs/)
accessibility-harness/*.png
accessibility-harness/package-lock.json
