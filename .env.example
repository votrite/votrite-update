APP_NAME=VotRite
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Public URL of this site, and the base URL used for asset() links.
# For local testing with the bundled mock API, set both to http://127.0.0.1:8000
APP_URL=https://your-domain.example
ASSET_URL=https://your-domain.example

# Backend API base URL. Point this at the real VotRite API.
# For local testing without the backend, run mock-api/server.mjs and use:
#   API=http://127.0.0.1:9191/api
API=https://your-api-host:9191/api

# Keyboard-first accessibility navigation (home-row + standard keys, ARIA,
# focus management). Set to false to roll back without a deploy.
KEYBOARD_NAV_ENABLED=true

LOG_CHANNEL=stack

# Database is NOT required for the voter flow (data comes from the API),
# but configure it if other features need it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
